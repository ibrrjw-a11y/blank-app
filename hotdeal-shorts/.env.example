# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 git에 올라가지 않습니다.

# 대본 자동 생성 (없으면 템플릿 대본으로 대체)
ANTHROPIC_API_KEY=

# 줄마다 AI 이미지 (둘 중 하나, config.yaml 의 images.provider 와 맞추기)
GEMINI_API_KEY=
OPENAI_API_KEY=

# 쿠팡파트너스 Open API (파트너스 사이트 > 추가기능 > API 에서 발급)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# 유튜브 성과 수집 (Google Cloud Console > YouTube Data API v3 > API 키)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
